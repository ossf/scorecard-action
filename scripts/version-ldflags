# Prints the -ldflags that set the Scorecard version and commit the action
# reports, derived from the github.com/ossf/scorecard/v5 requirement in go.mod.
set -euo pipefail

module=github.com/ossf/scorecard/v5

version=$(go list -m -f '{{.Version}}' "${module}")
if [[ -z "${version}" ]]; then
  echo "version-ldflags: no version for ${module} in go.mod" >&2
  exit 1
fi

# The module proxy reports the commit for both tags and pseudo-versions. A
# module cache populated before that was recorded can omit it, so fall back to
# the commit encoded in a pseudo-version.
commit=$(go mod download -json "${module}@${version}" |
  sed -n 's/^[[:space:]]*"Hash": "\([0-9a-f]\{40\}\)",\{0,1\}$/\1/p' | head -n 1)
if [[ -z "${commit}" && "${version}" =~ -([0-9a-f]{12})$ ]]; then
  commit="${BASH_REMATCH[1]}"
fi
if [[ -z "${commit}" ]]; then
  echo "version-ldflags: no commit for ${module}@${version}" >&2
  exit 1
fi

echo "-X sigs.k8s.io/release-utils/version.gitVersion=${version} -X sigs.k8s.io/release-utils/version.gitCommit=${commit}"
